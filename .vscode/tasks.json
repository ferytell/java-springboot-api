{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Spring Boot Project",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "compile"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javaTestRunner"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Run Spring Boot Application",
      "type": "shell",
      "command": "mvn",
      "args": ["spring-boot:run"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*?ERROR.*?$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Tomcat started on port.*",
          "endsPattern": ".*Application started.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Package Spring Boot Application",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "package"],
      "group": "build",
      "problemMatcher": ["$javaTestRunner"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
